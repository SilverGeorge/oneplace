# App configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database
# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oneplace

# Authentication
# Random long secret used to sign JWTs (32+ chars recommended).
JWT_SECRET=replace-with-a-long-random-secret
# Access token TTL in seconds.
JWT_EXPIRES_IN=3600
# bcrypt salt rounds for password hashing.
BCRYPT_SALT_ROUNDS=10

# Optional: password reset
# Used in links sent to users during reset flow.
RESET_PASSWORD_URL=http://localhost:3000/auth/reset-password
